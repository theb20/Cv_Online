        "message": "=<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n</head>\n<body style=\"margin:0; padding:0; background:#eef1f5; font-family:'Segoe UI',Arial,Helvetica,sans-serif; color:#1e293b;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eef1f5; padding:24px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:600px; max-width:600px; background:#ffffff; border-radius:14px; overflow:hidden; box-shadow:0 2px 10px rgba(15,23,42,0.08);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background:#0f172a; padding:28px 32px;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td style=\"border-left:4px solid #38bdf8; padding-left:16px;\">\n                    <div style=\"font-size:13px; letter-spacing:2px; text-transform:uppercase; color:#7dd3fc;\">Audit de sécurité</div>\n                    <div style=\"font-size:24px; font-weight:700; color:#ffffff; margin-top:4px;\">Rapport de scan</div>\n                    <div style=\"font-size:13px; color:#94a3b8; margin-top:6px;\">Localisation précise des failles &amp; recommandations</div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Note + score -->\n          <tr>\n            <td style=\"padding:32px 32px 8px 32px;\" align=\"center\">\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td align=\"center\"\n                      width=\"110\" height=\"110\"\n                      style=\"width:110px; height:110px; border-radius:55px; background:{{ ['A','B'].includes($json.grade) ? '#16a34a' : $json.grade === 'C' ? '#f59e0b' : '#dc2626' }}; color:#ffffff; font-size:52px; font-weight:800; line-height:110px; text-align:center;\">\n                    {{ $json.grade }}\n                  </td>\n                </tr>\n              </table>\n              <div style=\"font-size:14px; color:#64748b; margin-top:14px;\">Score de sécurité</div>\n              <div style=\"font-size:30px; font-weight:700; color:#0f172a;\">{{ $json.score }}<span style=\"font-size:16px; color:#94a3b8;\">/100</span></div>\n            </td>\n          </tr>\n\n          <!-- Sévérités -->\n          <tr>\n            <td style=\"padding:20px 24px 4px 24px;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td width=\"33%\" align=\"center\" style=\"padding:14px 0; background:#fef2f2; border-radius:10px;\">\n                    <div style=\"font-size:30px; font-weight:800; color:#dc2626;\">{{ $(\"Analyser Headers Sécurité\").item.json.counts.high }}</div>\n                    <div style=\"font-size:12px; color:#991b1b; text-transform:uppercase; letter-spacing:1px;\">Critiques</div>\n                  </td>\n                  <td width=\"12\">&nbsp;</td>\n                  <td width=\"33%\" align=\"center\" style=\"padding:14px 0; background:#fff7ed; border-radius:10px;\">\n                    <div style=\"font-size:30px; font-weight:800; color:#ea580c;\">{{ $(\"Analyser Headers Sécurité\").item.json.counts.medium }}</div>\n                    <div style=\"font-size:12px; color:#9a3412; text-transform:uppercase; letter-spacing:1px;\">Moyennes</div>\n                  </td>\n                  <td width=\"12\">&nbsp;</td>\n                  <td width=\"33%\" align=\"center\" style=\"padding:14px 0; background:#fefce8; border-radius:10px;\">\n                    <div style=\"font-size:30px; font-weight:800; color:#ca8a04;\">{{ $(\"Analyser Headers Sécurité\").item.json.counts.low }}</div>\n                    <div style=\"font-size:12px; color:#854d0e; text-transform:uppercase; letter-spacing:1px;\">Faibles</div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Métadonnées -->\n          <tr>\n            <td style=\"padding:24px 32px 8px 32px;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-size:14px; color:#334155;\">\n                <tr><td style=\"padding:6px 0; color:#64748b; width:140px;\">URL analysée</td><td style=\"padding:6px 0; font-weight:600; word-break:break-all;\">{{ $json.url_scannee }}</td></tr>\n                <tr><td style=\"padding:6px 0; color:#64748b;\">Date du scan</td><td style=\"padding:6px 0; font-weight:600;\">{{ $json.date_scan }}</td></tr>\n                <tr><td style=\"padding:6px 0; color:#64748b;\">Scanner</td><td style=\"padding:6px 0; font-weight:600;\">{{ $json.scanner }}</td></tr>\n                <tr><td style=\"padding:6px 0; color:#64748b;\">Total de failles</td><td style=\"padding:6px 0; font-weight:600;\">{{ $json.total_failles }}</td></tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Analyse IA -->\n          <tr>\n            <td style=\"padding:16px 32px 0 32px;\">\n              <div style=\"font-size:16px; font-weight:700; color:#0f172a; border-bottom:2px solid #e2e8f0; padding-bottom:8px; margin-bottom:12px;\">Analyse IA</div>\n              <div style=\"background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:16px; font-family:Consolas,Monaco,monospace; font-size:13px; color:#334155; white-space:pre-wrap; word-break:break-word;\">{{ $json.rapport_ia }}</div>\n            </td>\n          </tr>\n\n          <!-- Findings -->\n          <tr>\n            <td style=\"padding:20px 32px 8px 32px;\">\n              <div style=\"font-size:16px; font-weight:700; color:#0f172a; border-bottom:2px solid #e2e8f0; padding-bottom:8px; margin-bottom:12px;\">Findings détaillés</div>\n              <div style=\"background:#0f172a; border-radius:8px; padding:16px; font-family:Consolas,Monaco,monospace; font-size:12px; color:#cbd5e1; white-space:pre-wrap; word-break:break-word;\">{{ $json.findings_bruts }}</div>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding:24px 32px 28px 32px;\">\n              <div style=\"border-top:1px solid #e2e8f0; padding-top:16px; font-size:12px; color:#94a3b8; text-align:center; line-height:1.6;\">\n                Ce rapport identifie où se trouvent les problèmes de sécurité et comment les corriger.<br>\n                Généré automatiquement par n8n\n              </div>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
