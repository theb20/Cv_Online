    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\n\nconst headers = {};\nfor (const [k, v] of Object.entries(resp.headers || {})) {\n  headers[k.toLowerCase()] = Array.isArray(v) ? v.join(', ') : String(v);\n}\nconst finalUrl = resp.url || headers['location'] || '';\nconst isHttps = String(finalUrl).startsWith('https://');\n\nconst findings = [];\nconst add = (severity, id, title, location, fix) => findings.push({ severity, id, title, location, fix });\n\nif (!isHttps)\n  add('high', 'no-https', 'HTTPS non forcé', 'Configuration serveur / Redirections', 'Rediriger tout le HTTP vers HTTPS + activer HSTS.');\nif (!headers['strict-transport-security'])\n  add('high', 'no-hsts', 'HSTS absent', 'En-têtes HTTP de réponse', 'Strict-Transport-Security: max-age=63072000; includeSubDomains; preload');\nif (!headers['content-security-policy'])\n  add('high', 'no-csp', 'Content-Security-Policy absente', 'En-têtes HTTP de réponse', \"Définir une CSP restrictive (default-src 'self') contre le XSS.\");\nif ((headers['x-content-type-options'] || '').toLowerCase() !== 'nosniff')\n  add('medium', 'no-nosniff', 'X-Content-Type-Options manquant', 'En-têtes HTTP de réponse', 'X-Content-Type-Options: nosniff');\n\nconst frameAncestors = (headers['content-security-policy'] || '').includes('frame-ancestors');\nif (!headers['x-frame-options'] && !frameAncestors)\n  add('medium', 'clickjacking', 'Anti-clickjacking absent', 'En-têtes HTTP de réponse', \"X-Frame-Options: DENY ou CSP frame-ancestors 'none'.\");\nif (!headers['referrer-policy'])\n  add('low', 'no-referrer', 'Referrer-Policy absent', 'En-têtes HTTP de réponse', 'Referrer-Policy: strict-origin-when-cross-origin');\nif (!headers['permissions-policy'])\n  add('low', 'no-permissions', 'Permissions-Policy absent', 'En-têtes HTTP de réponse', 'Restreindre caméra/micro/géoloc via Permissions-Policy.');\n\nfor (const h of ['server', 'x-powered-by', 'x-aspnet-version']) {\n  if (headers[h]) add('low', 'info-disclosure', `Techno exposée via ${h}: ${headers[h]}`, 'En-têtes HTTP de réponse', `Masquer l'en-tête ${h}.`);\n}\n\nconst raw = resp.headers?.['set-cookie'];\nconst cookies = Array.isArray(raw) ? raw : (raw ? [raw] : []);\nfor (const c of cookies) {\n  const name = c.split('=')[0];\n  const lc = c.toLowerCase();\n  if (!lc.includes('secure'))   add('medium', 'cookie-secure', `Cookie ${name} sans Secure`, 'Configuration cookies (Set-Cookie)', 'Ajouter Secure.');\n  if (!lc.includes('httponly')) add('medium', 'cookie-httponly', `Cookie ${name} sans HttpOnly`, 'Configuration cookies (Set-Cookie)', 'Ajouter HttpOnly.');\n  if (!lc.includes('samesite')) add('low', 'cookie-samesite', `Cookie ${name} sans SameSite`, 'Configuration cookies (Set-Cookie)', 'Ajouter SameSite=Lax.');\n}\n\nconst weights = { high: 25, medium: 10, low: 4 };\nconst score = Math.max(0, findings.reduce((s, f) => s - (weights[f.severity] || 0), 100));\nconst grade = score >= 90 ? 'A' : score >= 75 ? 'B' : score >= 60 ? 'C' : score >= 40 ? 'D' : 'F';\n\nreturn [{\n  json: {\n    url: finalUrl,\n    https: isHttps,\n    statusCode: resp.statusCode || 0,\n    score,\n    grade,\n    counts: {\n      high: findings.filter(f => f.severity === 'high').length,\n      medium: findings.filter(f => f.severity === 'medium').length,\n      low: findings.filter(f => f.severity === 'low').length,\n    },\n    findings,\n    scannedAt: new Date().toISOString(),\n  }\n}];"
      },
